<UserControl x:Class="Responsible.ExView.SettingsExView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Responsible.ViewModel"
             xmlns:view="clr-namespace:Responsible.View"
             mc:Ignorable="d"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="760" d:DesignWidth="1300">
    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="{DynamicResource L.Settings.OpenConfig}"
                           Appearance="Secondary"
                           FontSize="12.5"
                           Padding="12,6"
                           Command="{Binding OpenConfigFileCommand}" />
                <ui:Button Style="{StaticResource MoeToolbarIconButtonStyle}"
                           Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                           Margin="8,0,0,0"
                           Command="{Binding CloseCommand}"
                           ToolTip="{DynamicResource L.Settings.Close}" />
            </StackPanel>
            <TextBlock Text="{DynamicResource L.Settings.Title}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="164" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     Style="{StaticResource SettingsNavListStyle}"
                     ItemsSource="{Binding NavItems}"
                     SelectedItem="{Binding SelectedNavItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsNavItemViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Label}"
                                       Margin="10,0,0,0"
                                       FontSize="13.5"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Column="1" Margin="18,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsModelsTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <view:SettingsModelsTab />
                </ScrollViewer>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsGeneralTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <view:SettingsGeneralTab />
                </ScrollViewer>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsRvmTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <view:SettingsRvmTab />
                </ScrollViewer>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsPlaceholderTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="Options24"
                                   FontSize="32"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding PlaceholderText}"
                               Margin="0,12,0,0"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>