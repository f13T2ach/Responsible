    <!--  Permission presets  -->
    <sys:String x:Key="L.Moe.Permission.RvmLabel">RVM 隔离保护</sys:String>
    <sys:String x:Key="L.Moe.Permission.RvmDescription">命令在独立会话盘上执行（工作区源码与配置按 git 索引选择性快照到本地 RVM 存储并挂载为盘符，之后只同步宿主变更），宿主工作区目录不授权给沙箱；临时文件写入会话盘内的专属 Temp。选择下方其它等级会关闭保护并恢复 DSH 沙箱。</sys:String>
    <sys:String x:Key="L.Moe.Permission.SafeBadge">安全</sys:String>
    <sys:String x:Key="L.Moe.Permission.AutoLabel">自动审查</sys:String>
    <sys:String x:Key="L.Moe.Permission.AutoDescription">无沙箱运行；每次原生工具调用和 PTC 内层调用前由同一模型进行实验性审查。</sys:String>
    <sys:String x:Key="L.Moe.Permission.AutoConfirmDescription">自动审查不使用沙箱。每次原生工具调用和 PTC 内层调用前，都会由与当前 agent 相同的模型进行审查；审查拒绝的调用由你批准或拒绝。此功能仍属实验性，可能误放行或误拒绝，并会消耗额外 token。</sys:String>
    <sys:String x:Key="L.Moe.Permission.FullAccessConfirmDescription">启用完全权限后，智能体将减少确认步骤，并且可以直接执行更多操作，包括敏感操作、文件修改或外部命令。仅建议在你信任当前任务时使用。</sys:String>
    <sys:String x:Key="L.Moe.Permission.ReadOnlyLabel">仅可查看</sys:String>
    <sys:String x:Key="L.Moe.Permission.ReadOnlyDescription">只能读取文件，写入与修改会被沙箱拒绝</sys:String>
    <sys:String x:Key="L.Moe.Permission.WorkspaceWriteLabel">工作区内修改</sys:String>
    <sys:String x:Key="L.Moe.Permission.WorkspaceWriteDescription">可在当前工作区内读写文件，工作区外的修改会被拒绝</sys:String>
    <sys:String x:Key="L.Moe.Permission.FullAccessLabel">完全权限</sys:String>
    <sys:String x:Key="L.Moe.Permission.FullAccessDescription">不再询问，可自由访问你的文件、终端和网络</sys:String>
    <sys:String x:Key="L.Moe.Permission.NotReadyTitle">审批强度暂不可改</sys:String>
