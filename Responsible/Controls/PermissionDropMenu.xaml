<UserControl x:Class="Responsible.Controls.PermissionDropMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Responsible.ViewModel"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignHeight="32" d:DesignWidth="180">
    <Grid>
        <ui:Button x:Name="TriggerButton"
                   Padding="8,4"
                   FontSize="12.5"
                   Click="OnTriggerClick"
                   ToolTip="{Binding CurrentDescription, ElementName=Root}">
            <ui:Button.Style>
                <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource MoeFlatButtonStyle}">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentIsDangerous, ElementName=Root}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentIsRvmProtection, ElementName=Root}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:Button.Style>
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="{Binding CurrentIcon, ElementName=Root}"
                               FontSize="16"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding CurrentHasIcon, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="{x:Type ui:SymbolIcon}">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentIsDangerous, ElementName=Root}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Setter Property="Filled" Value="True" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentIsRvmProtection, ElementName=Root}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Setter Property="Filled" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <TextBlock Text="{Binding CurrentLabel, ElementName=Root}"
                           MaxWidth="180"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentIsDangerous, ElementName=Root}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentIsRvmProtection, ElementName=Root}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ui:SymbolIcon x:Name="Chevron"
                               Symbol="ChevronDown24"
                               FontSize="11"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <ui:SymbolIcon.RenderTransform>
                        <RotateTransform Angle="0" />
                    </ui:SymbolIcon.RenderTransform>
                </ui:SymbolIcon>
            </StackPanel>
        </ui:Button>

        <Popup x:Name="MenuPopup"
               PlacementTarget="{Binding ElementName=TriggerButton}"
               Placement="Top"
               VerticalOffset="-6"
               HorizontalOffset="-8"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Opened="OnPopupOpened"
               Closed="OnPopupClosed">
            <Border Width="320"
                    MaxHeight="340"
                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
                <ListBox x:Name="OptionsList"
                         Style="{StaticResource ModelOptionsListStyle}"
                         ItemsSource="{Binding ItemsSource, ElementName=Root}"
                         IsSynchronizedWithCurrentItem="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PermissionOptionViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="{Binding Icon}"
                                               FontSize="14"
                                               Margin="0,2,10,0"
                                               VerticalAlignment="Top"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="{x:Type ui:SymbolIcon}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDangerous}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    <Setter Property="Filled" Value="True" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRvmProtection}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    <Setter Property="Filled" Value="True" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <ui:SymbolIcon Grid.Column="2"
                                               Symbol="Checkmark24"
                                               FontSize="14"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="13.5" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDangerous}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRvmProtection}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Margin="6,0,0,0"
                                                Padding="4,1"
                                                VerticalAlignment="Center"
                                                CornerRadius="4"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{Binding Badge, Converter={StaticResource NonEmptyStringToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Badge}"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Description, Converter={StaticResource NonEmptyStringToVisibilityConverter}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDangerous}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
