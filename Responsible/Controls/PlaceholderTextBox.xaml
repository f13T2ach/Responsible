<UserControl x:Class="Responsible.Controls.PlaceholderTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignHeight="38" d:DesignWidth="400">
    <Grid>
        <TextBox x:Name="Input"
                 Style="{Binding InputStyle, ElementName=Root, TargetNullValue={StaticResource MoeFieldTextBoxStyle}}"
                 Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{Binding Placeholder, ElementName=Root}"
                   Style="{StaticResource MoePlaceholderTextStyle}"
                   Margin="{Binding PlaceholderMargin, ElementName=Root}"
                   VerticalAlignment="Center"
                   Visibility="{Binding Text, ElementName=Input, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
    </Grid>
</UserControl>