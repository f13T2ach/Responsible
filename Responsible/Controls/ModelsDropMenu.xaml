<UserControl x:Class="Responsible.Controls.ModelsDropMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Responsible.ViewModel"
             xmlns:controls="clr-namespace:Responsible.Controls"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignHeight="32" d:DesignWidth="200">
    <Grid>
        <ui:Button x:Name="TriggerButton"
                   Style="{StaticResource MoeFlatButtonStyle}"
                   Padding="8,5"
                   FontSize="12.5"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Click="OnTriggerClick"
                   ToolTip="模型供应商">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectedItem.DisplayName, ElementName=Root, TargetNullValue=选择模型, FallbackValue=选择模型}"
                           VerticalAlignment="Center" />
                <ui:SymbolIcon x:Name="Chevron"
                               Symbol="ChevronDown24"
                               FontSize="12"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <ui:SymbolIcon.RenderTransform>
                        <RotateTransform Angle="0" />
                    </ui:SymbolIcon.RenderTransform>
                </ui:SymbolIcon>
            </StackPanel>
        </ui:Button>

        <Popup x:Name="MenuPopup"
               PlacementTarget="{Binding ElementName=TriggerButton}"
               Placement="{Binding Placement, ElementName=Root}"
               VerticalOffset="4"
               HorizontalOffset="-8"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Opened="OnPopupOpened"
               Closed="OnPopupClosed">
            <Border Width="340"
                    MaxHeight="440"
                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
                <DockPanel>
                    <controls:PlaceholderTextBox x:Name="SearchBox"
                                                 DockPanel.Dock="Top"
                                                 Placeholder="搜索模型..."
                                                 InputStyle="{StaticResource MoeInputTextBoxStyle}"
                                                 PlaceholderMargin="8,0"
                                                 Margin="6,6,6,4"
                                                 FontSize="13" />
                    <Grid>
                        <ListBox x:Name="OptionsList"
                                 Style="{StaticResource ModelOptionsListStyle}"
                                 IsSynchronizedWithCurrentItem="False">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       Margin="10,8,10,4"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ModelOptionViewModel}">
                                    <DockPanel>
                                        <ui:SymbolIcon DockPanel.Dock="Right"
                                                       Symbol="Checkmark24"
                                                       FontSize="14"
                                                       Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoMatches"
                                   Text="无匹配模型"
                                   FontSize="12.5"
                                   Margin="12,8"
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>