<UserControl x:Class="Responsible.Controls.RvmWorkspaceControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <!--  悬浮面板里的按钮：白底，同步黑字、撤销红字  -->
        <Style x:Key="HoverActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F2F2F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E5E5E5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" Background="Transparent">
        <!--  悬浮面板用 Popup：鼠标从按钮移到面板上时不会因为离开控件边界而消失  -->
        <Popup x:Name="HoverPopup"
               PlacementTarget="{Binding ElementName=OpenButton}"
               Placement="Top"
               VerticalOffset="-8"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Padding="6"
                    CornerRadius="14"
                    Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Opacity="0.3" ShadowDepth="2" Direction="270" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource HoverActionButton}"
                            Content="{DynamicResource L.Rvm.QuickSync}"
                            Command="{Binding SyncCommand, ElementName=Root}" />
                    <Button Style="{StaticResource HoverActionButton}"
                            Content="{DynamicResource L.Rvm.QuickRollback}"
                            Foreground="#DC2626"
                            Command="{Binding RollbackCommand, ElementName=Root}"
                            Margin="6,0,0,0" />
                </StackPanel>
            </Border>
        </Popup>

        <Button x:Name="OpenButton"
                Command="{Binding OpenSettingsCommand, ElementName=Root}"
                MinWidth="0"
                Cursor="Hand"
                BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="#16A34A"
                            CornerRadius="12"
                            Padding="10,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#15803D" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#166534" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="13" Foreground="White" />
                <TextBlock Text="{DynamicResource L.Rvm.OpenSettings}"
                           Margin="6,0,0,0"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="White" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
