<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Responsible.MoeViews\Responsible.MoeViews.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--  RWebView 构建产物：单文件 html，随输出目录部署供 WebView2 NavigateToString  -->
    <Content Include="..\RWebView\dist\index.html" Link="RWebView\index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\RWebView\dist\diff.html" Link="RWebView\diff.html" CopyToOutputDirectory="PreserveNewest" />
    <!--  WinFsp 安装包：设置页“安装 WinFsp”使用，离线可装  -->
    <Content Include="ThirdParty\WinFsp\winfsp-2.2.26323.msi" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
