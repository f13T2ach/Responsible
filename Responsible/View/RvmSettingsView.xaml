<UserControl x:Class="Responsible.View.RvmSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Responsible.ViewModel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RvmSettingsViewModel}"
             d:DesignWidth="600">
    <StackPanel Margin="2,4,8,4">
        <TextBlock FontSize="11.5"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{DynamicResource L.RvmSettings.EnvDesc}" />

        <Grid Margin="0,10,0,6">
            <TextBlock Text="{DynamicResource L.RvmSettings.EnvVars}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                <Run Text="{Binding SelectedEnvironmentText, Mode=OneWay}" />
            </TextBlock>
        </Grid>
        <ui:TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{DynamicResource L.RvmSettings.Filter}"
                    Margin="0,0,0,6" />
        <Border Height="132"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <ListBox ItemsSource="{Binding VisibleEnvironmentVariables}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RvmEnvironmentItem}">
                        <CheckBox IsChecked="{Binding IsSelected}"
                                  Content="{Binding DisplayName}"
                                  FontSize="12.5"
                                  Padding="2,3" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Margin="0,14,0,6">
            <TextBlock Text="{DynamicResource L.RvmSettings.Tools}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </Grid>
        <TextBlock FontSize="11.5"
                   Margin="0,0,0,6"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{DynamicResource L.RvmSettings.ToolsDesc}" />

        <Border MinHeight="54"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="4">
            <Grid>
                <TextBlock Text="{DynamicResource L.RvmSettings.NoTools}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="12,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding HasNoTools, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding ToolOptions}" MaxHeight="118">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RvmToolOptionItem}">
                            <CheckBox Margin="6,5"
                                      IsChecked="{Binding IsSelected}"
                                      IsEnabled="{Binding Available}"
                                      ToolTip="{Binding Path}">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Path}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
        <TextBlock Style="{StaticResource FieldWarningStyle}" Text="{Binding ToolError}" />
    </StackPanel>
</UserControl>