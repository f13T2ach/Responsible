<UserControl x:Class="Responsible.View.RvmSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Responsible.ViewModel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RvmSettingsViewModel}"
             d:DesignWidth="600">
    <StackPanel Margin="2,4,8,4">
        <TextBlock FontSize="11.5"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="沙箱默认只提供一套干净的环境变量。勾选需要额外提供给 AI 的变量（值在启动沙箱时读取，不写入磁盘）。勾选 PATH 时，宿主 PATH 中的绝对本地目录会追加到沙箱 PATH；相对路径、UNC 路径、工作区与临时目录会被忽略。" />

        <Grid Margin="0,10,0,6">
            <TextBlock Text="环境变量"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                <Run Text="已选 " /><Run Text="{Binding SelectedEnvironmentCount, Mode=OneWay}" /><Run Text=" 项" />
            </TextBlock>
        </Grid>
        <ui:TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="筛选环境变量…"
                    Margin="0,0,0,6" />
        <Border Height="132"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <ListBox ItemsSource="{Binding VisibleEnvironmentVariables}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RvmEnvironmentItem}">
                        <CheckBox IsChecked="{Binding IsSelected}"
                                  Content="{Binding DisplayName}"
                                  FontSize="12.5"
                                  Padding="2,3" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Margin="0,14,0,6">
            <TextBlock Text="工具目录"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </Grid>
        <TextBlock FontSize="11.5"
                   Margin="0,0,0,6"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="工具目录来自“设置 → 通用 → ACL 授权管理”。这里只决定本次会话允许使用哪些已授权工具；未勾选的工具不会进入沙箱 PATH，也不携带访问权限。" />

        <Border MinHeight="54"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="4">
            <Grid>
                <TextBlock Text="还没有全局授权的工具目录，请先到“设置 → 通用”添加。"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="12,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding HasNoTools, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding ToolOptions}" MaxHeight="118">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RvmToolOptionItem}">
                            <CheckBox Margin="6,5"
                                      IsChecked="{Binding IsSelected}"
                                      IsEnabled="{Binding Available}"
                                      ToolTip="{Binding Path}">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Path}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
        <TextBlock Style="{StaticResource FieldWarningStyle}" Text="{Binding ToolError}" />
    </StackPanel>
</UserControl>