<UserControl x:Class="Responsible.View.RvmSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Responsible.ViewModel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RvmSettingsViewModel}"
             d:DesignWidth="600">
    <StackPanel Margin="2,4,8,4">
        <TextBlock FontSize="11.5"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="沙箱默认只提供一套干净的环境变量。勾选需要额外提供给 AI 的变量（值在启动沙箱时读取，不写入磁盘），PATH 类变量由沙箱管理。" />

        <Grid Margin="0,10,0,6">
            <TextBlock Text="环境变量"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                <Run Text="已选 " /><Run Text="{Binding SelectedEnvironmentCount, Mode=OneWay}" /><Run Text=" 项" />
            </TextBlock>
        </Grid>
        <ui:TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="筛选环境变量…"
                    Margin="0,0,0,6" />
        <Border Height="132"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <ListBox ItemsSource="{Binding VisibleEnvironmentVariables}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RvmEnvironmentItem}">
                        <CheckBox IsChecked="{Binding IsSelected}"
                                  Content="{Binding DisplayName}"
                                  FontSize="12.5"
                                  Padding="2,3" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Margin="0,14,0,6">
            <TextBlock Text="工具目录"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:Button HorizontalAlignment="Right"
                       Content="添加目录"
                       Icon="{ui:SymbolIcon Symbol=FolderAdd24, FontSize=14}"
                       Appearance="Secondary"
                       FontSize="12"
                       Padding="10,5"
                       Click="OnAddTool" />
        </Grid>
        <TextBlock FontSize="11.5"
                   Margin="0,0,0,6"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="工具目录只授予读取与执行权限，并加入沙箱 PATH；其中的程序运行时会继承同一沙箱令牌，不能读写外部文件。" />

        <Border MinHeight="54"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="4">
            <Grid>
                <TextBlock Text="尚未提供工具目录"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding HasNoTools, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding Tools}" MaxHeight="118">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RvmToolItem}">
                            <DockPanel Margin="4,3">
                                <ui:Button DockPanel.Dock="Right"
                                           Style="{StaticResource MoeWorkspaceActionButtonStyle}"
                                           Icon="{ui:SymbolIcon Symbol=Dismiss24, FontSize=12}"
                                           ToolTip="移除"
                                           Command="{Binding DataContext.RemoveToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:SymbolIcon DockPanel.Dock="Left"
                                               Symbol="Folder24"
                                               FontSize="14"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Path}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
        <TextBlock Style="{StaticResource FieldWarningStyle}" Text="{Binding ToolError}" />
    </StackPanel>
</UserControl>