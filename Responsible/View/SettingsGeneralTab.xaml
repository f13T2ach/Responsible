<UserControl x:Class="Responsible.View.SettingsGeneralTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Responsible.ViewModel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">
    <StackPanel Margin="0,4,8,0">
        <TextBlock Text="通用设置"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock Text="窗口与内嵌 Web 内容共用同一套主题资源。"
                   FontSize="12.5"
                   Margin="0,6,0,14"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Border Style="{StaticResource ProviderCardStyle}" Padding="14,12">
            <StackPanel>
                <TextBlock Text="外观"
                           FontSize="14.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="主题模式立即作用于标题栏、侧栏、内容区与历史消息页。"
                           FontSize="12"
                           Margin="0,4,0,12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <UniformGrid Columns="3">
                    <RadioButton GroupName="ThemeMode"
                                 IsChecked="{Binding IsSystemTheme}"
                                 Margin="0,0,10,0">
                        <StackPanel Margin="4,0,0,0">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="18" HorizontalAlignment="Left" />
                            <TextBlock Text="跟随系统"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="随 Windows 外观切换"
                                       FontSize="11.5"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="ThemeMode"
                                 IsChecked="{Binding IsLightTheme}"
                                 Margin="0,0,10,0">
                        <StackPanel Margin="4,0,0,0">
                            <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="18" HorizontalAlignment="Left" />
                            <TextBlock Text="浅色"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="浅色填充，Web 同浅色背景"
                                       FontSize="11.5"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="ThemeMode"
                                 IsChecked="{Binding IsDarkTheme}">
                        <StackPanel Margin="4,0,0,0">
                            <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="18" HorizontalAlignment="Left" />
                            <TextBlock Text="深色"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="深色填充，Web 同深色背景"
                                       FontSize="11.5"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>