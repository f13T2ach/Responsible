<UserControl x:Class="Responsible.View.SettingsGeneralTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Responsible.ViewModel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">
    <StackPanel Margin="0,4,8,0">
        <TextBlock Text="通用设置"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock Text="窗口与内嵌 Web 内容共用同一套主题资源。"
                   FontSize="12.5"
                   Margin="0,6,0,14"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Border Style="{StaticResource ProviderCardStyle}" Padding="14,12">
            <StackPanel>
                <TextBlock Text="外观"
                           FontSize="14.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="主题模式立即作用于标题栏、侧栏、内容区与历史消息页。"
                           FontSize="12"
                           Margin="0,4,0,12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <UniformGrid Columns="3">
                    <RadioButton GroupName="ThemeMode"
                                 IsChecked="{Binding IsSystemTheme}"
                                 Margin="0,0,10,0">
                        <StackPanel Margin="4,0,0,0">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="18" HorizontalAlignment="Left" />
                            <TextBlock Text="跟随系统"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="随 Windows 外观切换"
                                       FontSize="11.5"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="ThemeMode"
                                 IsChecked="{Binding IsLightTheme}"
                                 Margin="0,0,10,0">
                        <StackPanel Margin="4,0,0,0">
                            <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="18" HorizontalAlignment="Left" />
                            <TextBlock Text="浅色"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="浅色填充，Web 同浅色背景"
                                       FontSize="11.5"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="ThemeMode"
                                 IsChecked="{Binding IsDarkTheme}">
                        <StackPanel Margin="4,0,0,0">
                            <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="18" HorizontalAlignment="Left" />
                            <TextBlock Text="深色"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="深色填充，Web 同深色背景"
                                       FontSize="11.5"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource ProviderCardStyle}" Padding="14,12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="WinFsp 虚拟盘"
                           FontSize="14.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="沙箱把工作区挂载为独立盘符：Base 只读、Diff 可写，会话结束即回滚。"
                           FontSize="12"
                           Margin="0,4,0,12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="HardDrive24"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <Run Text="状态：" />
                            <Run Text="{Binding WinFspStatusText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="安装后 RVM 会话才能挂载工作区盘符；未安装时会话退回 DSH 沙箱。"
                                   FontSize="11.5"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="正在安装 WinFsp，请在系统提示中确认管理员权限…"
                                   FontSize="11.5"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding IsWinFspBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <ui:Button Content="{Binding WinFspInstallerText}"
                                   Appearance="Secondary"
                                   FontSize="12.5"
                                   Padding="12,6"
                                   Command="{Binding InstallWinFspCommand}"
                                   IsEnabled="{Binding IsWinFspNotBusy}" />
                        <ui:Button Style="{StaticResource MoeToolbarIconButtonStyle}"
                                   Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                                   Margin="8,0,0,0"
                                   ToolTip="重新检测 WinFsp"
                                   Command="{Binding RefreshWinFspCommand}"
                                   IsEnabled="{Binding IsWinFspNotBusy}" />
                    </StackPanel>
                </Grid>

                <Separator Margin="0,12,0,10"
                           Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="虚拟盘符"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ComboBox Grid.Column="1"
                              Width="78"
                              Margin="12,0,0,0"
                              ItemsSource="{Binding WinFspDriveLetters}"
                              SelectedItem="{Binding WinFspDriveLetter}"
                              IsEnabled="{Binding IsWinFspNotBusy}" />
                    <TextBlock Grid.Column="2"
                               Text="默认 R:；仅影响 RVM 挂载的工作区盘符。"
                               FontSize="11.5"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>

                <TextBlock Text="{Binding WinFspError}"
                           Margin="0,10,0,0"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Visibility="{Binding WinFspError, Converter={StaticResource NonEmptyStringToVisibilityConverter}}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>