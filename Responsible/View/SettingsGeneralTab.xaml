<UserControl x:Class="Responsible.View.SettingsGeneralTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Responsible.ViewModel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">
    <StackPanel Margin="0,4,8,0">
        <TextBlock Text="{DynamicResource L.General.Title}"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock Text="{DynamicResource L.General.Subtitle}"
                   FontSize="12.5"
                   Margin="0,6,0,14"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Border Style="{StaticResource ProviderCardStyle}" Padding="14,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.General.Appearance}"
                           FontSize="14.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{DynamicResource L.General.AppearanceDesc}"
                           FontSize="12"
                           Margin="0,4,0,12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <UniformGrid Columns="3">
                    <RadioButton GroupName="ThemeMode"
                                 IsChecked="{Binding IsSystemTheme}"
                                 Margin="0,0,10,0">
                        <StackPanel Margin="4,0,0,0">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="18" HorizontalAlignment="Left" />
                            <TextBlock Text="{DynamicResource L.General.System}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{DynamicResource L.General.SystemDesc}"
                                       FontSize="11.5"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="ThemeMode"
                                 IsChecked="{Binding IsLightTheme}"
                                 Margin="0,0,10,0">
                        <StackPanel Margin="4,0,0,0">
                            <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="18" HorizontalAlignment="Left" />
                            <TextBlock Text="{DynamicResource L.General.Light}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{DynamicResource L.General.LightDesc}"
                                       FontSize="11.5"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="ThemeMode"
                                 IsChecked="{Binding IsDarkTheme}">
                        <StackPanel Margin="4,0,0,0">
                            <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="18" HorizontalAlignment="Left" />
                            <TextBlock Text="{DynamicResource L.General.Dark}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{DynamicResource L.General.DarkDesc}"
                                       FontSize="11.5"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource ProviderCardStyle}" Padding="14,12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.General.Language}"
                           FontSize="14.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{DynamicResource L.General.LanguageDesc}"
                           FontSize="12"
                           Margin="0,4,0,12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox Width="200"
                          HorizontalAlignment="Left"
                          FontSize="13"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguage}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>