<UserControl x:Class="Responsible.View.WorkspaceEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Responsible.ViewModel"
             xmlns:controls="clr-namespace:Responsible.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WorkspaceEditorViewModel}"
             d:DesignHeight="560" d:DesignWidth="640">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,0,0,4">
            <ui:Button DockPanel.Dock="Right"
                       Style="{StaticResource MoeWorkspaceActionButtonStyle}"
                       Icon="{ui:SymbolIcon Symbol=Dismiss24, FontSize=14}"
                       Command="{Binding CancelCommand}"
                       ToolTip="关闭" />
            <TextBlock Text="新建工作区"
                       FontSize="17"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" MaxHeight="470" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,8,0">
                <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,6" Text="文件所在位置" />
                <ComboBox Width="340"
                          HorizontalAlignment="Left"
                          FontSize="13"
                          ItemsSource="{Binding LocationOptions}"
                          SelectedItem="{Binding SelectedLocation}" />

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="源文件夹" />
                <Grid Height="96"
                      Margin="0,0,0,4"
                      AllowDrop="True"
                      DragOver="OnFoldersDragOver"
                      Drop="OnFoldersDropped">
                    <Rectangle Style="{StaticResource MoeDropZoneStyle}" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <ui:SymbolIcon Symbol="FolderAdd24"
                                       FontSize="18"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="点击添加可读写文件夹"
                                   Margin="8,0,0,0"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Background="Transparent"
                               BorderThickness="0"
                               Appearance="Transparent"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               AllowDrop="True"
                               Click="OnBrowseFolders"
                               Cursor="Hand"
                               ToolTip="选择文件夹，也可以直接把文件夹拖到这里" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Folders}" Margin="0,0,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FolderItemViewModel}">
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,7"
                                    Margin="0,0,0,6">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right"
                                               Style="{StaticResource MoeWorkspaceActionButtonStyle}"
                                               Icon="{ui:SymbolIcon Symbol=Dismiss24, FontSize=12}"
                                               Margin="6,0,0,0"
                                               Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="移除文件夹" />
                                    <ui:SymbolIcon DockPanel.Dock="Left"
                                                   Symbol="Folder24"
                                                   FontSize="15"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Path}"
                                                   FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="工作区名称" />
                <controls:PlaceholderTextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Placeholder="输入名称…" />
                <TextBlock Style="{StaticResource FieldWarningStyle}"
                           Text="{Binding ErrorText}"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <CheckBox Margin="0,14,0,0"
                          IsChecked="{Binding RvmProtection}"
                          VerticalContentAlignment="Top">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="RVM 隔离保护"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="命令在独立沙箱会话中执行，工作区经专属盘符挂载，临时文件写入工作区专属 Temp。未勾选时使用 DSH 自带沙箱。" />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <ui:Button Content="取消"
                       Appearance="Secondary"
                       FontSize="13"
                       Padding="20,8"
                       Command="{Binding CancelCommand}" />
            <ui:Button Content="创建"
                       Style="{StaticResource ConfirmButtonStyle}"
                       FontSize="13"
                       Padding="20,8"
                       Margin="8,0,0,0"
                       Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
