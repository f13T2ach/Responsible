<UserControl x:Class="Responsible.View.WorkspaceEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Responsible.ViewModel"
             xmlns:controls="clr-namespace:Responsible.Controls"
             xmlns:views="clr-namespace:Responsible.View"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WorkspaceEditorViewModel}"
             d:DesignHeight="560" d:DesignWidth="640">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,0,0,4">
            <ui:Button DockPanel.Dock="Right"
                       Style="{StaticResource MoeWorkspaceActionButtonStyle}"
                       Icon="{ui:SymbolIcon Symbol=Dismiss24, FontSize=14}"
                       Command="{Binding CancelCommand}"
                       ToolTip="{DynamicResource L.Common.Close}" />
            <TextBlock Text="{DynamicResource L.Workspace.New}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" MaxHeight="470" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,8,0">
                <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,6" Text="{DynamicResource L.Workspace.Location}" />
                <ComboBox Width="340"
                          HorizontalAlignment="Left"
                          FontSize="13"
                          ItemsSource="{Binding LocationOptions}"
                          SelectedItem="{Binding SelectedLocation}" />

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource L.Workspace.SourceFolders}" />
                <Grid Height="96"
                      Margin="0,0,0,4"
                      AllowDrop="True"
                      DragOver="OnFoldersDragOver"
                      Drop="OnFoldersDropped">
                    <Rectangle Style="{StaticResource MoeDropZoneStyle}" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <ui:SymbolIcon Symbol="FolderAdd24"
                                       FontSize="18"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{DynamicResource L.Workspace.AddFolderHint}"
                                   Margin="8,0,0,0"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Background="Transparent"
                               BorderThickness="0"
                               Appearance="Transparent"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               AllowDrop="True"
                               Click="OnBrowseFolders"
                               Cursor="Hand"
                               ToolTip="{DynamicResource L.Workspace.PickFolder}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Folders}" Margin="0,0,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FolderItemViewModel}">
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,7"
                                    Margin="0,0,0,6">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right"
                                               Style="{StaticResource MoeWorkspaceActionButtonStyle}"
                                               Icon="{ui:SymbolIcon Symbol=Dismiss24, FontSize=12}"
                                               Margin="6,0,0,0"
                                               Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="{DynamicResource L.Workspace.RemoveFolder}" />
                                    <ui:SymbolIcon DockPanel.Dock="Left"
                                                   Symbol="Folder24"
                                                   FontSize="15"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Path}"
                                                   FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource L.Workspace.Name}" />
                <controls:PlaceholderTextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Placeholder="{DynamicResource L.Workspace.NamePlaceholder}" />
                <TextBlock Style="{StaticResource FieldWarningStyle}"
                           Text="{Binding ErrorText}"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <CheckBox Margin="0,14,0,0"
                          IsChecked="{Binding RvmProtection}"
                          VerticalContentAlignment="Top">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="{DynamicResource L.Workspace.RvmProtection}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{DynamicResource L.Workspace.RvmDescription}" />
                    </StackPanel>
                </CheckBox>

                <Border Margin="0,10,0,0"
                        Padding="12,10"
                        CornerRadius="6"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="{Binding RvmProtection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="Folder24"
                                           FontSize="16"
                                           Margin="0,1,8,0"
                                           VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource L.Workspace.GitSnapshot}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding GitIndexStatus}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding IsGitIndexNeeded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:Button Content="{DynamicResource L.Workspace.FullIndex}"
                                       Appearance="Primary"
                                       FontSize="12"
                                       Padding="12,5"
                                       ToolTip="{DynamicResource L.Workspace.FullIndexTip}"
                                       Command="{Binding InitializeFullGitIndexCommand}"
                                       IsEnabled="{Binding IsGitIndexIdle}" />
                            <ui:Button Content="{DynamicResource L.Workspace.NormalIndex}"
                                       Appearance="Secondary"
                                       FontSize="12"
                                       Padding="12,5"
                                       Margin="8,0,0,0"
                                       ToolTip="{DynamicResource L.Workspace.NormalIndexTip}"
                                       Command="{Binding InitializeGitIndexCommand}"
                                       IsEnabled="{Binding IsGitIndexIdle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Expander Margin="0,10,0,0"
                          Padding="10,4"
                          IsExpanded="{Binding RvmSettingsOpen, Mode=TwoWay}"
                          Visibility="{Binding RvmProtection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24"
                                           FontSize="15"
                                           Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{DynamicResource L.Workspace.RvmSettings}"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Expander.Header>
                    <views:RvmSettingsView DataContext="{Binding RvmSettings}" Margin="0,4,0,0" />
                </Expander>

                <Border Margin="0,10,0,0"
                        Padding="10,8"
                        CornerRadius="6"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsRvmSkipWarningVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left"
                                           Symbol="Warning24"
                                           FontSize="16"
                                           Margin="0,1,8,0"
                                           VerticalAlignment="Top"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock FontSize="12.5"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{DynamicResource L.Workspace.IsolatedWarning}" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <ui:Button Content="{DynamicResource L.Workspace.BackToSettings}"
                                       Appearance="Secondary"
                                       FontSize="12"
                                       Padding="12,5"
                                       Command="{Binding DismissRvmWarningCommand}" />
                            <ui:Button Content="{DynamicResource L.Workspace.CreateAnyway}"
                                       Appearance="Primary"
                                       FontSize="12"
                                       Padding="12,5"
                                       Margin="8,0,0,0"
                                       Command="{Binding ContinueWithoutRvmSettingsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <ui:Button Content="{DynamicResource L.Common.Cancel}"
                       Appearance="Secondary"
                       FontSize="13"
                       Padding="20,8"
                       Command="{Binding CancelCommand}" />
            <ui:Button Content="{DynamicResource L.Workspace.Create}"
                       Style="{StaticResource ConfirmButtonStyle}"
                       FontSize="13"
                       Padding="20,8"
                       Margin="8,0,0,0"
                       Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
