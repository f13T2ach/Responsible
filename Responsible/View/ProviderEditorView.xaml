<UserControl x:Class="Responsible.View.ProviderEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:Responsible.ViewModel"
             xmlns:controls="clr-namespace:Responsible.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProviderEditorViewModel}"
             d:DesignHeight="640" d:DesignWidth="760">
    <Grid Margin="4,4,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ContentDialog 模板以无限高度测量内容且自带 2px 溢出，滚动区上限须与 DialogHeight 配套才能让 footer 常驻、外层不出滚动条  -->
        <ScrollViewer Grid.Row="0" MaxHeight="586" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TabControl Style="{StaticResource SegmentedTabControlStyle}"
                            SelectedIndex="{Binding ModeIndex}">
                    <TabItem Header="{DynamicResource L.Provider.TabCatalog}">
                        <StackPanel Margin="0,16,8,0">
                            <TextBlock Style="{StaticResource FieldDescriptionStyle}"
                                       Text="{DynamicResource L.Provider.CatalogDesc}" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource L.Provider.Provider}" />
                            <ComboBox Width="340"
                                      HorizontalAlignment="Left"
                                      FontSize="13"
                                      ItemsSource="{Binding Catalog}"
                                      SelectedItem="{Binding SelectedCatalogEntry}"
                                      DisplayMemberPath="DisplayName" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,6">
                                <TextBlock Text="{DynamicResource L.Provider.ApiKey}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ui:SymbolIcon Symbol="QuestionCircle24"
                                               FontSize="14"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               ToolTip="{DynamicResource L.Provider.ApiKeyTip}" />
                            </StackPanel>
                            <controls:PlaceholderTextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                         Placeholder="{Binding EnvKeyPlaceholder}" />
                            <TextBlock Style="{StaticResource FieldWarningStyle}"
                                       Text="{Binding EnvWarningText}"
                                       Visibility="{Binding ShowEnvWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Separator Margin="0,16" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <Expander Style="{StaticResource MoeDialogExpanderStyle}"
                                      IsExpanded="True"
                                      Header="{DynamicResource L.Provider.CustomSettings}">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" Text="{DynamicResource L.Provider.BaseUrl}" />
                                    <controls:PlaceholderTextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                                                 Placeholder="{DynamicResource L.Provider.BaseUrlPlaceholder}" />
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding RegionsHint}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="{DynamicResource L.Provider.TabCustom}">
                        <StackPanel Margin="0,16,8,0">
                            <TextBlock Style="{StaticResource FieldDescriptionStyle}"
                                       Text="{DynamicResource L.Provider.CustomDesc}" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Provider ID" />
                            <controls:PlaceholderTextBox Text="{Binding ProviderId, UpdateSourceTrigger=PropertyChanged}"
                                                         Placeholder="acme-gateway" />
                            <TextBlock Style="{StaticResource FieldHintStyle}"
                                       Text="{DynamicResource L.Provider.ProviderIdHint}" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource L.Provider.DisplayName}" />
                            <controls:PlaceholderTextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                         Placeholder="{DynamicResource L.Provider.DisplayNamePlaceholder}" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource L.Provider.BaseUrl}" />
                            <controls:PlaceholderTextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                                         Placeholder="https://gateway.example/v1" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource L.Provider.Protocol}" />
                            <ComboBox Width="340"
                                      HorizontalAlignment="Left"
                                      FontSize="13"
                                      SelectedItem="{Binding Protocol}">
                                <sys:String>OpenAI Chat Completions</sys:String>
                                <sys:String>Anthropic Messages</sys:String>
                            </ComboBox>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource L.Provider.ApiKey}" />
                            <controls:PlaceholderTextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                         Placeholder="{DynamicResource L.Provider.ApiKeyPlaceholder}" />
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!--  模型目录：两种模式共用  -->
                <StackPanel Margin="0,16,0,0">
                    <Separator Margin="0,0,0,16" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <DockPanel Margin="0,0,0,6">
                        <ui:Button DockPanel.Dock="Right"
                                   Content="{DynamicResource L.Provider.FetchModels}"
                                   Style="{StaticResource MoeFlatButtonStyle}"
                                   FontSize="12.5"
                                   Padding="8,4"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Command="{Binding FetchModelsCommand}" />
                        <TextBlock Text="{DynamicResource L.Provider.Catalog}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource FieldHintStyle}"
                               Margin="0,0,0,10"
                               Text="{Binding ModelsSubtitle}"
                               Visibility="{Binding ModeIndex, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=!1}" />

                    <ItemsControl ItemsSource="{Binding Models}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProviderModelEntryViewModel}">
                                <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        Margin="0,0,0,6">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right"
                                                   Style="{StaticResource MoeToolbarIconButtonStyle}"
                                                   Icon="{ui:SymbolIcon Symbol=Dismiss24, FontSize=12}"
                                                   Margin="6,0,0,0"
                                                   Command="{Binding DataContext.RemoveModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="{DynamicResource L.Provider.RemoveModel}" />
                                        <TextBox Style="{StaticResource MoeInputTextBoxStyle}"
                                                 FontSize="13"
                                                 Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Height="54"
                          Visibility="{Binding Models.Count, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=0}">
                        <Rectangle Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                   StrokeThickness="1"
                                   StrokeDashArray="5 4"
                                   RadiusX="10"
                                   RadiusY="10" />
                        <TextBlock Text="{DynamicResource L.Provider.EmptyModels}"
                                   FontSize="12.5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ui:Button Content="{DynamicResource L.Provider.AddModel}"
                               Appearance="Secondary"
                               FontSize="12.5"
                               Padding="12,5"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Left"
                               Icon="{ui:SymbolIcon Symbol=Add24, FontSize=14}"
                               Command="{Binding AddModelCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <ui:Button Content="{DynamicResource L.Common.Cancel}"
                       Appearance="Secondary"
                       FontSize="13"
                       Padding="20,8"
                       Command="{Binding CancelCommand}" />
            <ui:Button Content="{DynamicResource L.Common.Save}"
                       Style="{StaticResource ConfirmButtonStyle}"
                       FontSize="13"
                       Padding="20,8"
                       Margin="8,0,0,0"
                       Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>