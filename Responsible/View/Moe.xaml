<UserControl x:Class="Responsible.View.Moe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Responsible.ViewModel"
             xmlns:controls="clr-namespace:Responsible.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MoeViewModel}"
             d:DesignHeight="760" d:DesignWidth="1324">
    <Grid x:Name="RootGrid" Focusable="True" FocusVisualStyle="{x:Null}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部：toolbar 即标题栏。菜单簇与搜索栏同处叠加层以保证垂直居中
              （TitleBar 模板的窗口按钮行会挤偏 Header）；点击由 Moe.xaml.cs 经 WndProcInvoked 放行  -->
        <Grid Grid.Row="0" Height="32">
            <ui:TitleBar x:Name="HostTitleBar"
                         Height="32"
                         Padding="0"
                         Background="Transparent"
                         ShowHelp="False"
                         Title="{x:Null}" />

            <!--  叠加层：左侧菜单簇 + 整窗居中的搜索栏（宽窗口胶囊 / 窄窗口图标 / 浮动搜索框）  -->
            <Grid x:Name="ToolbarOverlay">
                <StackPanel x:Name="LeftCluster"
                            Margin="6,0,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <ui:Button Style="{StaticResource MoeToolbarIconButtonStyle}"
                               Icon="{ui:SymbolIcon Symbol=PanelLeft24}"
                               Command="{Binding ToggleSidebarCommand}"
                               ToolTip="收起 / 展开左边栏" />
                    <Menu VerticalAlignment="Center" Background="Transparent" FontSize="13">
                        <ui:MenuItem Header="文件" Style="{StaticResource MoeToolbarMenuItemStyle}"
                                     Template="{StaticResource MoeTopLevelMenuItemTemplate}">
                            <ui:MenuItem Header="新建对话" Icon="{ui:SymbolIcon Symbol=Add24}" />
                            <ui:MenuItem Header="打开工作区" Icon="{ui:SymbolIcon Symbol=FolderOpen24}" />
                        </ui:MenuItem>
                        <ui:MenuItem Header="编辑" Style="{StaticResource MoeToolbarMenuItemStyle}"
                                     Template="{StaticResource MoeTopLevelMenuItemTemplate}">
                            <ui:MenuItem Command="ApplicationCommands.Undo" Icon="{ui:SymbolIcon Symbol=ArrowUndo24}" />
                            <ui:MenuItem Command="ApplicationCommands.Redo" Icon="{ui:SymbolIcon Symbol=ArrowRedo24}" />
                            <Separator />
                            <ui:MenuItem Command="ApplicationCommands.Cut" Icon="{ui:SymbolIcon Symbol=Cut24}" />
                            <ui:MenuItem Command="ApplicationCommands.Copy" Icon="{ui:SymbolIcon Symbol=Copy24}" />
                            <ui:MenuItem Command="ApplicationCommands.Paste" Icon="{ui:SymbolIcon Symbol=ClipboardPaste24}" />
                        </ui:MenuItem>
                        <ui:MenuItem Header="视图" Style="{StaticResource MoeToolbarMenuItemStyle}"
                                     Template="{StaticResource MoeTopLevelMenuItemTemplate}">
                            <ui:MenuItem Header="左边栏"
                                         IsCheckable="True"
                                         IsChecked="{Binding IsSidebarVisible, Mode=OneWay}"
                                         Command="{Binding ToggleSidebarCommand}"
                                         Icon="{ui:SymbolIcon Symbol=PanelLeft24}" />
                        </ui:MenuItem>
                        <ui:MenuItem Header="审查" Style="{StaticResource MoeToolbarMenuItemStyle}"
                                     Template="{StaticResource MoeTopLevelMenuItemTemplate}">
                            <ui:MenuItem Header="开始审查" Icon="{ui:SymbolIcon Symbol=Play24}" />
                        </ui:MenuItem>
                        <ui:MenuItem Header="帮助" Style="{StaticResource MoeToolbarMenuItemStyle}"
                                     Template="{StaticResource MoeTopLevelMenuItemTemplate}">
                            <ui:MenuItem Header="文档" Icon="{ui:SymbolIcon Symbol=Book24}" />
                            <ui:MenuItem Header="关于" Icon="{ui:SymbolIcon Symbol=Info24}" />
                        </ui:MenuItem>
                    </Menu>
                    <ui:Button Style="{StaticResource MoeToolbarIconButtonStyle}"
                               Icon="{ui:SymbolIcon Symbol=Search24}"
                               Command="{Binding OpenSearchCommand}"
                               ToolTip="搜索 (Ctrl+K)"
                               Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BreakpointToVisibilityConverter}, ConverterParameter=1100:narrow}" />
                </StackPanel>
                <Border HorizontalAlignment="Center"
                        Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BreakpointToVisibilityConverter}, ConverterParameter=1100:wide}">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource MoeSearchPillStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFocused, ElementName=PillSearchBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel Margin="10,0">
                        <ui:SymbolIcon DockPanel.Dock="Left"
                                       Symbol="Search24"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Grid>
                            <TextBox x:Name="PillSearchBox"
                                     Style="{StaticResource MoeInputTextBoxStyle}"
                                     FontSize="12.5"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="搜索"
                                       Style="{StaticResource MoePlaceholderTextStyle}"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Text, ElementName=PillSearchBox, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                        </Grid>
                    </DockPanel>
                </Border>
                <Border Width="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,32,0,0"
                        Panel.ZIndex="10"
                        Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                        Visibility="{Binding IsSearchOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource MoeSearchPillStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFocused, ElementName=FloatingSearchBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel Margin="10,0">
                        <ui:SymbolIcon DockPanel.Dock="Left"
                                       Symbol="Search24"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Grid>
                            <TextBox x:Name="FloatingSearchBox"
                                     Style="{StaticResource MoeInputTextBoxStyle}"
                                     FontSize="12.5"
                                     VerticalAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Escape" Command="{Binding CloseSearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="搜索"
                                       Style="{StaticResource MoePlaceholderTextStyle}"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Text, ElementName=FloatingSearchBox, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!--  主体：左边栏 + 内容区  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左边栏  -->
            <Border Grid.Column="0"
                    Width="264"
                    Visibility="{Binding IsSidebarVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="Transparent">
                <DockPanel>
                    <!--  上方：插件 / 自动化 / 安全  -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                        <ui:Button Style="{StaticResource MoeSidebarButtonStyle}"
                                   Icon="{ui:SymbolIcon Symbol=PuzzlePiece24}"
                                   Content="插件" />
                        <ui:Button Style="{StaticResource MoeSidebarButtonStyle}"
                                   Icon="{ui:SymbolIcon Symbol=Bot24}"
                                   Content="自动化" />
                        <ui:Button Style="{StaticResource MoeSidebarButtonStyle}"
                                   Icon="{ui:SymbolIcon Symbol=Shield24}"
                                   Content="安全" />
                        <Separator Margin="12,8" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    </StackPanel>

                    <!--  下方：站点 / 用户 / 设置  -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                        <Separator Margin="12,4,12,8" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <ui:Button Style="{StaticResource MoeSidebarButtonStyle}"
                                   Icon="{ui:SymbolIcon Symbol=Globe24}"
                                   Content="站点" />
                        <ui:Button Style="{StaticResource MoeSidebarButtonStyle}"
                                   Icon="{ui:SymbolIcon Symbol=Person24}"
                                   Content="用户" />
                        <ui:Button Style="{StaticResource MoeSidebarButtonStyle}"
                                   Icon="{ui:SymbolIcon Symbol=Settings24}"
                                   Content="设置"
                                   Command="{Binding OpenSettingsCommand}" />
                    </StackPanel>

                    <!--  中部：工作区列表（展开后显示对话列表）  -->
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="工作区" Style="{StaticResource MoeSidebarSectionHeaderStyle}" />
                        <ui:Button Grid.Column="1"
                                   Style="{StaticResource MoeToolbarIconButtonStyle}"
                                   Icon="{ui:SymbolIcon Symbol=Add24, FontSize=14}"
                                   Margin="0,0,10,0"
                                   ToolTip="新建工作区" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Workspaces}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WorkspaceItemViewModel}">
                                    <Expander Style="{StaticResource MoeWorkspaceExpanderStyle}"
                                              IsExpanded="{Binding IsExpanded}">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Folder24" FontSize="16"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Name}" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <ListBox Style="{StaticResource MoeConversationListStyle}"
                                                 ItemsSource="{Binding Conversations}"
                                                 SelectedItem="{Binding DataContext.SelectedConversation, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ConversationItemViewModel}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Chat24" FontSize="14" />
                                                        <TextBlock Text="{Binding Title}" Margin="8,0,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!--  内容区：圆角纯色面板（主题自适应，可承载 WebView2）  -->
            <Border Grid.Column="1"
                    x:Name="ContentPanel"
                    Style="{StaticResource MoeContentPanelStyle}"
                    Margin="8,6,10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                <!--  历史消息区：WebView2 承载 RWebView（运行时缺失时控件内降级）  -->
                <controls:ChatWebView Grid.Row="0" Session="{Binding Session}" />

                <!--  输入区  -->
                <Border Grid.Row="1"
                        x:Name="InputCard"
                        MaxWidth="920"
                        Margin="24,8,24,16"
                        Padding="12">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="14" />
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFocused, ElementName=PromptBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <ui:DropDownButton HorizontalAlignment="Left"
                                               Appearance="Transparent"
                                               BorderThickness="0"
                                               Icon="{ui:SymbolIcon Symbol=Add24}"
                                               ToolTip="添加内容">
                                <ui:DropDownButton.Flyout>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <ui:MenuItem Header="添加文件" Icon="{ui:SymbolIcon Symbol=Document24}" />
                                        <ui:MenuItem Header="添加图片" Icon="{ui:SymbolIcon Symbol=Image24}" />
                                        <ui:MenuItem Header="添加对话" Icon="{ui:SymbolIcon Symbol=Chat24}" />
                                        <Separator />
                                        <ui:MenuItem Header="调用指令" Icon="{ui:SymbolIcon Symbol=WindowDevTools24}" />
                                    </ContextMenu>
                                </ui:DropDownButton.Flyout>
                            </ui:DropDownButton>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <controls:ModelsDropMenu ItemsSource="{Binding ModelOptions}"
                                                         SelectedItem="{Binding SelectedModelOption, Mode=TwoWay}"
                                                         Placement="Top" />
                                <ui:Button Margin="4,0,0,0"
                                           Appearance="Primary"
                                           Icon="{ui:SymbolIcon Symbol=ArrowUp24}"
                                           Command="{Binding SendPromptCommand}"
                                           ToolTip="发送 (Enter)" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <TextBox x:Name="PromptBox"
                                     Style="{StaticResource MoeInputTextBoxStyle}"
                                     Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontSize="14"
                                     MinHeight="24"
                                     MaxHeight="{Binding ActualHeight, ElementName=ContentPanel, Converter={StaticResource FractionConverter}, ConverterParameter=0.3333}"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendPromptCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="发消息或创建任务，/ 调用指令，@ 文件或对话"
                                       Style="{StaticResource MoePlaceholderTextStyle}"
                                       FontSize="14"
                                       VerticalAlignment="Top"
                                       Visibility="{Binding Text, ElementName=PromptBox, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                        </Grid>
                    </DockPanel>
                </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  底部状态栏  -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10">
            <ui:SymbolIcon Symbol="History24" Style="{StaticResource MoeStatusIconStyle}" Margin="4,0,2,0" />
            <TextBlock Style="{StaticResource MoeStatusTextStyle}">
                <Run Text="{Binding Rounds, Mode=OneWay}" /><Run Text=" 轮 " /><Run Text="{Binding Steps, Mode=OneWay}" /><Run Text=" 步" />
            </TextBlock>
            <TextBlock Style="{StaticResource MoeStatusTextStyle}" Text="·" Margin="10,0" />
            <ui:SymbolIcon Symbol="Flash24" Style="{StaticResource MoeStatusIconStyle}" Margin="4,0,2,0" />
            <TextBlock Style="{StaticResource MoeStatusTextStyle}"
                       Text="{Binding TokensPerSecond, StringFormat={}{0} tok/s}" />
            <TextBlock Style="{StaticResource MoeStatusTextStyle}" Text="·" Margin="10,0" />
            <ui:SymbolIcon Symbol="Database24" Style="{StaticResource MoeStatusIconStyle}" Margin="4,0,2,0" />
            <TextBlock Style="{StaticResource MoeStatusTextStyle}"
                       Text="{Binding TokenUsageText, StringFormat={}{0} · 缓存命中}" />
            <TextBlock Style="{StaticResource MoeStatusTextStyle}"
                       Text="{Binding CacheHitRateText}" Margin="4,0,0,0" />
            <TextBlock Style="{StaticResource MoeStatusTextStyle}" Text="·" Margin="10,0" />
            <ui:SymbolIcon Symbol="Gauge24" Style="{StaticResource MoeStatusIconStyle}" Margin="4,0,2,0" />
            <TextBlock Style="{StaticResource MoeStatusTextStyle}"
                       Text="{Binding ContextUsagePercent, StringFormat={}{0}% 上下文}"
                       ToolTip="上下文容量占用" />
        </StackPanel>
    </Grid>
</UserControl>