<UserControl x:Class="Responsible.View.Moe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Responsible.ViewModel"
             xmlns:controls="clr-namespace:Responsible.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MoeViewModel}"
             d:DesignHeight="760" d:DesignWidth="1324">
    <Grid x:Name="RootGrid" Focusable="True" FocusVisualStyle="{x:Null}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部：toolbar 即标题栏。菜单簇与搜索栏同处叠加层以保证垂直居中
              （TitleBar 模板的窗口按钮行会挤偏 Header）；点击由 Moe.xaml.cs 经 WndProcInvoked 放行  -->
        <Grid Grid.Row="0" Height="32">
            <ui:TitleBar x:Name="HostTitleBar"
                         Height="32"
                         Padding="0"
                         Background="Transparent"
                         ShowHelp="False"
                         Title="{x:Null}" />

            <!--  叠加层：左侧菜单簇 + 整窗居中的搜索栏（宽窗口胶囊 / 窄窗口图标 / 浮动搜索框）  -->
            <Grid x:Name="ToolbarOverlay">
                <StackPanel x:Name="LeftCluster"
                            Margin="6,0,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <ui:Button Style="{StaticResource MoeToolbarIconButtonStyle}"
                               Icon="{ui:SymbolIcon Symbol=PanelLeft24}"
                               Command="{Binding ToggleSidebarCommand}"
                               ToolTip="{DynamicResource L.Moe.ToggleSidebar}" />
                    <Menu VerticalAlignment="Center" Background="Transparent" FontSize="13">
                        <ui:MenuItem Header="{DynamicResource L.Moe.MenuFile}" Style="{StaticResource MoeToolbarMenuItemStyle}"
                                     Template="{StaticResource MoeTopLevelMenuItemTemplate}">
                            <ui:MenuItem Header="{DynamicResource L.Moe.NewChat}" Icon="{ui:SymbolIcon Symbol=Add24}"
                                         Command="{Binding NewConversationCommand}" />
                            <ui:MenuItem Header="{DynamicResource L.Moe.OpenWorkspace}" Icon="{ui:SymbolIcon Symbol=FolderOpen24}" />
                        </ui:MenuItem>
                        <ui:MenuItem Header="{DynamicResource L.Moe.MenuEdit}" Style="{StaticResource MoeToolbarMenuItemStyle}"
                                     Template="{StaticResource MoeTopLevelMenuItemTemplate}">
                            <ui:MenuItem Command="ApplicationCommands.Undo" Icon="{ui:SymbolIcon Symbol=ArrowUndo24}" />
                            <ui:MenuItem Command="ApplicationCommands.Redo" Icon="{ui:SymbolIcon Symbol=ArrowRedo24}" />
                            <Separator />
                            <ui:MenuItem Command="ApplicationCommands.Cut" Icon="{ui:SymbolIcon Symbol=Cut24}" />
                            <ui:MenuItem Command="ApplicationCommands.Copy" Icon="{ui:SymbolIcon Symbol=Copy24}" />
                            <ui:MenuItem Command="ApplicationCommands.Paste" Icon="{ui:SymbolIcon Symbol=ClipboardPaste24}" />
                        </ui:MenuItem>
                        <ui:MenuItem Header="{DynamicResource L.Moe.MenuView}" Style="{StaticResource MoeToolbarMenuItemStyle}"
                                     Template="{StaticResource MoeTopLevelMenuItemTemplate}">
                            <ui:MenuItem Header="{DynamicResource L.Moe.Sidebar}"
                                         IsCheckable="True"
                                         IsChecked="{Binding IsSidebarVisible, Mode=OneWay}"
                                         Command="{Binding ToggleSidebarCommand}"
                                         Icon="{ui:SymbolIcon Symbol=PanelLeft24}" />
                        </ui:MenuItem>
                        <ui:MenuItem Header="{DynamicResource L.Moe.MenuHelp}" Style="{StaticResource MoeToolbarMenuItemStyle}"
                                     Template="{StaticResource MoeTopLevelMenuItemTemplate}">
                            <ui:MenuItem Header="{DynamicResource L.Moe.Docs}" Icon="{ui:SymbolIcon Symbol=Book24}" />
                            <ui:MenuItem Header="{DynamicResource L.Moe.About}" Icon="{ui:SymbolIcon Symbol=Info24}" />
                        </ui:MenuItem>
                    </Menu>
                    <ui:Button Style="{StaticResource MoeToolbarIconButtonStyle}"
                               Icon="{ui:SymbolIcon Symbol=Search24}"
                               Command="{Binding OpenSearchCommand}"
                               ToolTip="{DynamicResource L.Moe.SearchTip}"
                               Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BreakpointToVisibilityConverter}, ConverterParameter=1100:narrow}" />
                </StackPanel>
                <Border HorizontalAlignment="Center"
                        Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BreakpointToVisibilityConverter}, ConverterParameter=1100:wide}">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource MoeSearchPillStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFocused, ElementName=PillSearchBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel Margin="10,0">
                        <ui:SymbolIcon DockPanel.Dock="Left"
                                       Symbol="Search24"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Grid>
                            <TextBox x:Name="PillSearchBox"
                                     Style="{StaticResource MoeInputTextBoxStyle}"
                                     FontSize="12.5"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource L.Common.Search}"
                                       Style="{StaticResource MoePlaceholderTextStyle}"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Text, ElementName=PillSearchBox, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                        </Grid>
                    </DockPanel>
                </Border>
                <Border Width="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,32,0,0"
                        Panel.ZIndex="10"
                        Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                        Visibility="{Binding IsSearchOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource MoeSearchPillStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFocused, ElementName=FloatingSearchBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel Margin="10,0">
                        <ui:SymbolIcon DockPanel.Dock="Left"
                                       Symbol="Search24"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Grid>
                            <TextBox x:Name="FloatingSearchBox"
                                     Style="{StaticResource MoeInputTextBoxStyle}"
                                     FontSize="12.5"
                                     VerticalAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Escape" Command="{Binding CloseSearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="{DynamicResource L.Common.Search}"
                                       Style="{StaticResource MoePlaceholderTextStyle}"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Text, ElementName=FloatingSearchBox, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!--  主体：左边栏 + 内容区  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左边栏  -->
            <Border Grid.Column="0"
                    Width="264"
                    Visibility="{Binding IsSidebarVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="Transparent">
                <DockPanel>
                    <!--  上方：插件 / 自动化 / 安全  -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                        <ui:Button Icon="{ui:SymbolIcon Symbol=PuzzlePiece24}"
                                   Content="{DynamicResource L.Common.Plugins}"
                                   Command="{Binding OpenPluginsCommand}">
                            <ui:Button.Style>
                                <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource MoeSidebarButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMoeViewOpen}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Style="{StaticResource MoeSidebarButtonStyle}"
                                   Icon="{ui:SymbolIcon Symbol=Bot24}"
                                   Content="{DynamicResource L.Moe.Automation}" />
                        <ui:Button Style="{StaticResource MoeSidebarButtonStyle}"
                                   Icon="{ui:SymbolIcon Symbol=Shield24}"
                                   Content="{DynamicResource L.Moe.Security}" />
                        <Separator Margin="12,8" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    </StackPanel>

                    <!--  下方：站点 / 用户 / 设置  -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                        <Separator Margin="12,4,12,8" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <ui:Button Style="{StaticResource MoeSidebarButtonStyle}"
                                   Icon="{ui:SymbolIcon Symbol=Globe24}"
                                   Content="{DynamicResource L.Moe.Sites}" />
                        <ui:Button Style="{StaticResource MoeSidebarButtonStyle}"
                                   Icon="{ui:SymbolIcon Symbol=Settings24}"
                                   Content="{DynamicResource L.Common.Settings}"
                                   Command="{Binding OpenSettingsCommand}" />
                    </StackPanel>

                    <!--  中部：工作区列表（展开后显示对话列表）  -->
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource L.Moe.Workspaces}" Style="{StaticResource MoeSidebarSectionHeaderStyle}" />
                        <ui:Button Grid.Column="1"
                                   Style="{StaticResource MoeToolbarIconButtonStyle}"
                                   Icon="{ui:SymbolIcon Symbol=Add24, FontSize=14}"
                                   Margin="0,0,10,0"
                                   Command="{Binding CreateWorkspaceCommand}"
                                   ToolTip="{DynamicResource L.Moe.NewWorkspace}" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Top"
                               Margin="16,6,16,2"
                               FontSize="12"
                               Text="{DynamicResource L.Common.Loading}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding IsConversationsLoaded, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=!True}" />

                    <TextBlock DockPanel.Dock="Top"
                               Margin="16,6,16,2"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="{Binding ConversationsErrorText}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Visibility="{Binding HasConversationsError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Workspaces}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WorkspaceItemViewModel}">
                                    <Expander Style="{StaticResource MoeWorkspaceExpanderStyle}"
                                              IsExpanded="{Binding IsExpanded}">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Grid Width="21" Height="18">
                                                        <ui:SymbolIcon Symbol="Folder24" FontSize="16"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Top"
                                                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        <Border Width="11"
                                                                Height="11"
                                                                CornerRadius="5.5"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Margin="0,0,-2,-2"
                                                                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                                                ToolTip="{DynamicResource L.Moe.RvmProtected}"
                                                                Visibility="{Binding IsRvmProtected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <ui:SymbolIcon Symbol="ShieldCheckmark24"
                                                                           FontSize="9"
                                                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Margin="8,0,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                        <Run Text="{Binding DirtyMark, Mode=OneWay}"
                                                             Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <!--  行内操作：仅悬停或键盘聚焦时出现  -->
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Margin="6,0,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="{x:Type StackPanel}">
                                                            <Setter Property="Opacity" Value="0" />
                                                            <Setter Property="IsHitTestVisible" Value="False" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                    <Setter Property="IsHitTestVisible" Value="True" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                    <Setter Property="IsHitTestVisible" Value="True" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <ui:DropDownButton Appearance="Transparent"
                                                                       BorderThickness="0"
                                                                       Padding="3"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       Icon="{ui:SymbolIcon Symbol=MoreHorizontal24, FontSize=14}"
                                                                       ToolTip="{DynamicResource L.Moe.WorkspaceMenu}">
                                                        <ui:DropDownButton.Flyout>
                                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                <ui:MenuItem Header="{DynamicResource L.Moe.NewChat}"
                                                                             Icon="{ui:SymbolIcon Symbol=Add24}"
                                                                             Command="{Binding NewConversationCommand}" />
                                                                <ui:MenuItem Header="{DynamicResource L.Moe.OpenInExplorer}"
                                                                             Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                                                             Command="{Binding OpenFolderCommand}" />
                                                                <ui:MenuItem Header="{DynamicResource L.Moe.RvmSettings}"
                                                                             Icon="{ui:SymbolIcon Symbol=Shield24}"
                                                                             Command="{Binding EditRvmSettingsCommand}"
                                                                             Visibility="{Binding CanConfigureRvm, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Separator />
                                                                <ui:MenuItem Header="{DynamicResource L.Moe.RemoveFromSidebar}"
                                                                             Icon="{ui:SymbolIcon Symbol=DeleteDismiss24}"
                                                                             Command="{Binding RemoveFromSidebarCommand}"
                                                                             Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            </ContextMenu>
                                                        </ui:DropDownButton.Flyout>
                                                    </ui:DropDownButton>
                                                    <ui:Button Style="{StaticResource MoeWorkspaceActionButtonStyle}"
                                                               Icon="{ui:SymbolIcon Symbol=Add24, FontSize=14}"
                                                               Command="{Binding NewConversationCommand}"
                                                               ToolTip="{DynamicResource L.Moe.NewChatInWorkspace}" />
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        <ListBox Style="{StaticResource MoeConversationListStyle}"
                                                 ItemsSource="{Binding Conversations}"
                                                 MouseLeftButtonUp="OnConversationClicked">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ConversationItemViewModel}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Chat24" FontSize="14" />
                                                            <TextBlock Text="{Binding Title}" Margin="8,0,0,0"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <ui:Button Grid.Column="1"
                                                                   Icon="{ui:SymbolIcon Symbol=DeleteDismiss24, FontSize=13}"
                                                                   Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding}"
                                                                   ToolTip="{DynamicResource L.Moe.DeleteChat}">
                                                            <ui:Button.Style>
                                                                <Style TargetType="{x:Type ui:Button}"
                                                                       BasedOn="{StaticResource MoeWorkspaceActionButtonStyle}">
                                                                    <Setter Property="Visibility"
                                                                            Value="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    <Setter Property="Opacity" Value="0" />
                                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                                     Value="True">
                                                                            <Setter Property="Opacity" Value="1" />
                                                                            <Setter Property="IsHitTestVisible" Value="True" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:Button.Style>
                                                        </ui:Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!--  内容区：圆角纯色面板（主题自适应，可承载 WebView2）  -->
            <Border Grid.Column="1"
                    x:Name="ContentPanel"
                    Style="{StaticResource MoeContentPanelStyle}"
                    Margin="8,6,10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                <!--  历史消息区：WebView2 承载 RWebView（运行时缺失时控件内降级）  -->
                <controls:ChatWebView Grid.Row="0" Grid.Column="0" x:Name="HistoryView" Session="{Binding Session}" DiffRequested="OnDiffRequested" />

                <!--  输入区  -->
                <Border Grid.Row="1"
                        Grid.Column="0"
                        x:Name="InputCard"
                        MaxWidth="920"
                        Margin="24,8,24,16"
                        Padding="12">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="14" />
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFocused, ElementName=PromptBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMoeViewOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSessionLoading}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                <ui:DropDownButton Appearance="Transparent"
                                                   BorderThickness="0"
                                                   Icon="{ui:SymbolIcon Symbol=Add24}"
                                                   ToolTip="{DynamicResource L.Moe.AddContent}">
                                    <ui:DropDownButton.Flyout>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <ui:MenuItem Header="{DynamicResource L.Moe.AddFile}" Icon="{ui:SymbolIcon Symbol=Document24}" />
                                            <ui:MenuItem Header="{DynamicResource L.Moe.AddImage}" Icon="{ui:SymbolIcon Symbol=Image24}" />
                                            <ui:MenuItem Header="{DynamicResource L.Moe.AddChat}" Icon="{ui:SymbolIcon Symbol=Chat24}" />
                                            <Separator />
                                            <ui:MenuItem Header="{DynamicResource L.Moe.InvokeCommand}" Icon="{ui:SymbolIcon Symbol=WindowDevTools24}" />
                                        </ContextMenu>
                                    </ui:DropDownButton.Flyout>
                                </ui:DropDownButton>
                                <!--  DSH 的 conversation.input.permission：沙箱模式 + 审批策略，输入框下方靠左  -->
                                <controls:PermissionDropMenu Margin="6,0,0,0"
                                                             VerticalAlignment="Center"
                                                             ItemsSource="{Binding PermissionOptions}"
                                                             CurrentLabel="{Binding PermissionLabel}"
                                                             CurrentIcon="{Binding PermissionIcon}"
                                                             CurrentHasIcon="{Binding PermissionHasIcon}"
                                                             CurrentDescription="{Binding PermissionDescription}"
                                                             CurrentIsDangerous="{Binding PermissionIsDangerous}"
                                                             CurrentIsRvmProtection="{Binding PermissionIsRvmProtection}"
                                                             SelectCommand="{Binding SelectPermissionCommand}"
                                                             IsEnabled="{Binding PermissionEnabled}" />
                                <!--  受 RVM 保护时：本区设置 + 悬停同步/撤销  -->
                                <controls:RvmWorkspaceControls Margin="6,0,0,0"
                                                               VerticalAlignment="Center"
                                                               OpenSettingsCommand="{Binding OpenWorkspaceRvmSettingsCommand}"
                                                               SyncCommand="{Binding SyncRvmWorkspaceCommand}"
                                                               RollbackCommand="{Binding RollbackRvmWorkspaceCommand}"
                                                               Visibility="{Binding IsRvmControlsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <controls:ModelsDropMenu ItemsSource="{Binding ModelOptions}"
                                                         SelectedItem="{Binding SelectedModelOption, Mode=TwoWay}"
                                                         Placement="Top" />
                                <ui:Button Margin="4,0,0,0"
                                           Appearance="Primary"
                                           Icon="{ui:SymbolIcon Symbol=ArrowUp24}"
                                           Command="{Binding SendPromptCommand}"
                                           ToolTip="{DynamicResource L.Moe.SendTip}" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <TextBox x:Name="PromptBox"
                                     Style="{StaticResource MoeInputTextBoxStyle}"
                                     Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontSize="14"
                                     MinHeight="24"
                                     MaxHeight="{Binding ActualHeight, ElementName=ContentPanel, Converter={StaticResource FractionConverter}, ConverterParameter=0.3333}"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendPromptCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="{DynamicResource L.Moe.PromptPlaceholder}"
                                       FontSize="14"
                                       VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MoePlaceholderTextStyle}">
                                        <Setter Property="Visibility"
                                                Value="{Binding Text, ElementName=PromptBox, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSessionLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource L.Common.Loading}"
                                       Style="{StaticResource MoePlaceholderTextStyle}"
                                       FontSize="14"
                                       VerticalAlignment="Top"
                                       Visibility="{Binding IsSessionLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!--  Moe 内容区页面：整块覆盖历史区与输入区（WebView2 已在打开期间折叠，规避空域）  -->
                <controls:MoeViewHost Grid.RowSpan="2"
                                      Grid.ColumnSpan="2"
                                      Panel.ZIndex="10"
                                      Background="{DynamicResource ApplicationBackgroundBrush}" />

                <!--  本轮改动：独立的右侧 WebView（占一列），对话与输入框整体退让  -->
                <Border Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        CornerRadius="10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="0" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NeverExpands}" Value="True">
                                    <Setter Property="Width" Value="470" />
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!--  右侧改动面板：WPF 原生渲染（不走第二个 WebView2，避免 airspace 吞点击）  -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  tab 条：DSH 的 review 就是一个 tab（“第 N 轮改”）  -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Margin="6,4,0,0"
                                    Padding="10,3"
                                    CornerRadius="6,6,0,0"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1,1,1,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Changes.TabTitle}" FontSize="12" VerticalAlignment="Center" />
                                    <ui:Button Margin="6,0,0,0"
                                               Padding="2"
                                               Icon="{ui:SymbolIcon Symbol=Dismiss24, FontSize=10}"
                                               Command="{Binding ToggleChangesPanelCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--  header：文件选择器 + 行数 + 工具（照 DSH 的 selector 与 tools）  -->
                        <Grid Grid.Row="1" Height="38" Margin="8,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding Changes.ToggleFileMenuCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,0"
                                    Height="28"
                                    HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="16" Height="16" CornerRadius="3"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Changes.Selected.Status}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Changes.Selected.Display}" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                    <ui:SymbolIcon Symbol="ChevronDown24" FontSize="10" Margin="4,0,0,0" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding Changes.Files}">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Command" Value="{Binding DataContext.Changes.PickFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Setter Property="CommandParameter" Value="{Binding}" />
                                                <Setter Property="Header" Value="{Binding Display}" />
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Changes.SelectedCounts}"
                                       FontFamily="Consolas, Cascadia Mono"
                                       FontSize="11.5"
                                       Margin="10,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <ui:Button Padding="6" Icon="{ui:SymbolIcon Symbol=Dismiss24, FontSize=12}"
                                           Command="{Binding ToggleChangesPanelCommand}"
                                           ToolTip="{DynamicResource L.Changes.Close}" />
                            </StackPanel>
                        </Grid>
                        <!--  diff：hunk 头 + 双行号行  -->
                        <Grid Grid.Row="2">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding Changes.HasLines, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding Changes.Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DiffLine}">
                                            <Grid x:Name="Row" MinHeight="22">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Old" Grid.Column="0" Text="{Binding Old}"
                                                           FontFamily="Consolas, Cascadia Mono" FontSize="11.5"
                                                           TextAlignment="Right" Margin="0,0,8,0" />
                                                <TextBlock x:Name="New" Grid.Column="1" Text="{Binding New}"
                                                           FontFamily="Consolas, Cascadia Mono" FontSize="11.5"
                                                           TextAlignment="Right" Margin="0,0,8,0" />
                                                <TextBlock x:Name="Sign" Grid.Column="2" Text="{Binding Sign}"
                                                           FontFamily="Consolas, Cascadia Mono" FontSize="11.5"
                                                           TextAlignment="Center" />
                                                <TextBlock x:Name="Body" Grid.Column="3" Text="{Binding Text}"
                                                           FontFamily="Consolas, Cascadia Mono" FontSize="11.5"
                                                           TextWrapping="NoWrap" Margin="0,0,12,0" />
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="add">
                                                                <Setter Property="Background" Value="#1A6CCB5F" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="del">
                                                                <Setter Property="Background" Value="#1AFF99A4" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{Binding Changes.EmptyHint}"
                                       Margin="18"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Changes.HasLines}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  底部状态栏：只显示 RVM 运行态（就绪、会话盘、网络、设备）  -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"
                    ToolTip="{Binding RvmFooterDetail}"
                    Visibility="{Binding IsRvmFooterVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:SymbolIcon Symbol="ShieldCheckmark24"
                           Style="{StaticResource MoeStatusIconStyle}"
                           Margin="4,0,4,0" />
            <TextBlock Style="{StaticResource MoeStatusTextStyle}"
                       Text="{Binding RvmFooterText}" />
        </StackPanel>
    </Grid>
</UserControl>
