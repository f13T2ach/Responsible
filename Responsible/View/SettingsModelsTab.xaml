<UserControl x:Class="Responsible.View.SettingsModelsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Responsible.ViewModel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">
    <StackPanel Margin="0,4,8,0">
        <TextBlock Text="{DynamicResource L.ModelsTab.Title}"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock Text="{DynamicResource L.ModelsTab.Subtitle}"
                   FontSize="12.5"
                   Margin="0,6,0,14"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ItemsControl ItemsSource="{Binding Providers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ProviderViewModel}">
                    <Border Style="{StaticResource ProviderCardStyle}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Content="{DynamicResource L.ModelsTab.Edit}"
                                           Appearance="Secondary"
                                           FontSize="12.5"
                                           Padding="12,5"
                                           Command="{Binding DataContext.EditProviderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Visibility="{Binding Kind, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=!Account}" />
                                <ui:Button Content="{DynamicResource L.ModelsTab.Delete}"
                                           Style="{StaticResource MoeFlatButtonStyle}"
                                           FontSize="12.5"
                                           Padding="12,5"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Command="{Binding DataContext.DeleteProviderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Visibility="{Binding Kind, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=!Account}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="14.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Border CornerRadius="4"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Padding="6,2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Kind, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Custom}">
                                    <TextBlock Text="{DynamicResource L.ModelsTab.Custom}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <Ellipse Width="8" Height="8"
                                         Margin="10,0,0,0"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource ProviderStatusDotStyle}" />
                                <TextBlock Text="{DynamicResource L.ModelsTab.SignedIn}"
                                           FontSize="13"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                           Visibility="{Binding Kind, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Account}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Style="{StaticResource DashedAddButtonStyle}"
                Height="40"
                Margin="0,4,0,0"
                Command="{Binding AddProviderCommand}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,8,0" />
                <TextBlock Text="{DynamicResource L.ModelsTab.Add}" FontSize="13.5" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>